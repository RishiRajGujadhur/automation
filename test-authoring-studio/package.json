{
  "name": "test-authoring-studio",
  "version": "1.0.0",
  "description": "Local SpecFlow + Playwright test authoring studio with a React 19 client and Roslyn indexing.",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "cli": "tsx server/cli.ts",
    "scanner:build": "node scripts/build-scanner.mjs",
    "debugger:setup": "node scripts/setup-debugger.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
