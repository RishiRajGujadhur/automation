{
  "name": "test-authoring-desktop",
  "productName": "TestAuthoring Studio",
  "version": "1.0.0",
  "description": "Desktop (Electron) version of TestAuthoring Studio. Reuses the studio's React client and Express API.",
  "author": "RishiRajGujadhur",
  "license": "ISC",
  "private": true,
  "type": "module",
  "main": "out/main/main.mjs",
  "scripts": {
    "build:studio": "npm --prefix ../test-authoring-studio run build",
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && electron .",
    "dev": "node scripts/build.mjs --skip-studio && electron .",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/build.mjs --skip-studio && playwright test",
    "icon": "node scripts/icon.mjs",
    "dist": "node scripts/icon.mjs && node scripts/build.mjs && electron-builder --win",
    "pack": "node scripts/icon.mjs && node scripts/build.mjs && electron-builder --win --dir"
  },
  "build": {
    "appId": "dev.testauthoring.studio",
    "productName": "TestAuthoring Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "studio",
        "to": "studio"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "protocols": [
      {
        "name": "TestAuthoring Studio link",
        "schemes": [
          "testauthoring"
        ]
      }
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "playwright": "^1.64.0"
  },
  "allowScripts": {
    "electron@44.7.0": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  }
}
